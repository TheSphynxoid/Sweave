sweave-web/tsconfig.tsbuildinfo
sweave-web/tsconfig.node.tsbuildinfo
sweave-web/scripts/shots/

# Agent scratch (throwaway runner scripts + captured outputs land here
# by habit; they are work product of a turn, not repo work — prefer
# the OS temp dir, never commit these)
runfull.py
full_out*.txt
scratch-*.py
test_out*.txt
test_full*.txt
theme_fail*.txt

