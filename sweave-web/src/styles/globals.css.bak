/* Tailwind v4 (R4.1 step 1c) -- CSS-first theme. The `@theme`
 * block defines design tokens as CSS custom properties; Tailwind
 * generates `bg-<name>`, `text-<name>`, `border-<name>` etc.
 * utilities that resolve to `var(--color-<name>)`.
 *
 * The runtime theme path (``applyThemeToDocument`` in
 * src/lib/theme/switcher.ts) writes the same variables per
 * active preset -- the `--color-*` defaults below are the
 * "dark" preset's first paint so the UI is not unstyled before
 * the JS hydrates.
 *
 * Token format: each `--color-<name>` is a full ``rgb()`` value
 * so the Tailwind utilities work without an arbitrary-value
 * wrapper. The runtime writes ``rgb(<r> <g> <b>)`` to match.
 * (The shipped tokens.ts uses bare ``<r> <g> <b>`` tuples; the
 * runtime's CSS writer wraps them. See the R4.1 step 1c
 * commit for the wrapping details.)
 */
@import "tailwindcss";
@import "tw-animate-css";
@import './animations.css';

@custom-variant dark (&:is([data-theme="dark"] *));

@theme {
  --color-background: rgb(15 23 42);
  --color-foreground: rgb(248 250 252);
  --color-muted: rgb(30 41 59);
  --color-muted-foreground: rgb(148 163 184);
  --color-border: rgb(30 41 59);
  --color-primary: rgb(167 139 250);
  --color-primary-foreground: rgb(15 23 42);
  --color-secondary: rgb(30 41 59);
  --color-secondary-foreground: rgb(248 250 252);
  --color-destructive: rgb(239 68 68);
  --color-destructive-foreground: rgb(255 255 255);
  --color-accent: rgb(30 41 59);
  --color-accent-foreground: rgb(248 250 252);
  --color-card: rgb(30 41 59);
  --color-card-foreground: rgb(248 250 252);
  --color-popover: rgb(30 41 59);
  --color-popover-foreground: rgb(248 250 252);
  --color-ring: rgb(167 139 250);
  --color-input: rgb(30 41 59);

  /* The static <style> element the runtime writes to starts
   * with a copy of the dark preset (the @theme defaults); the
   * :root[data-theme=...] selector then narrows per active
   * preset. The static CSS keeps the first paint unstyled. */
  --radius: 0.5rem;
}

/* The light preset -- narrow :root[data-theme=light] with
 * overrides for the same tokens. Runtime writes the same shape. */
:root[data-theme="light"] {
  --color-background: rgb(255 255 255);
  --color-foreground: rgb(15 23 42);
  --color-muted: rgb(241 245 249);
  --color-muted-foreground: rgb(100 116 139);
  --color-border: rgb(226 232 240);
  --color-primary: rgb(139 92 246);
  --color-primary-foreground: rgb(255 255 255);
  --color-secondary: rgb(241 245 249);
  --color-secondary-foreground: rgb(15 23 42);
  --color-destructive: rgb(239 68 68);
  --color-destructive-foreground: rgb(255 255 255);
  --color-accent: rgb(241 245 249);
  --color-accent-foreground: rgb(15 23 42);
  --color-card: rgb(255 255 255);
  --color-card-foreground: rgb(15 23 42);
  --color-popover: rgb(255 255 255);
  --color-popover-foreground: rgb(15 23 42);
  --color-ring: rgb(139 92 246);
  --color-input: rgb(226 232 240);
}

/* Other presets (dracula / nord / catppuccin) are applied at
 * runtime by applyThemeToDocument -- see src/lib/theme/switcher.ts.
 * The @theme defaults + :root[data-theme=light] cover the
 * non-JS first paint; the runtime injection replaces them
 * per active preset.
 */
* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  /* R4.1 step 1c: v4 tokens carry full rgb() values, so the
   * consumer references ``var(--color-*)`` directly. No
   * rgb() wrapper. */
  background-color: var(--color-background);
  color: var(--color-foreground);
}

/* Subtle "agent" ambience: a faint primary-tinted glow in the
 * top-right corner so the surface isn't a flat slab. */
body {
  background-image: radial-gradient(
    48rem 48rem at 100% 0%,
    color-mix(in oklch, var(--color-primary) 9%, transparent),
    transparent 60%
  );
  background-attachment: fixed;
}

::selection {
  background: color-mix(in oklch, var(--color-primary) 30%, transparent);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: color-mix(in oklch, var(--color-muted-foreground) 30%, transparent);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: color-mix(in oklch, var(--color-muted-foreground) 50%, transparent);
}

@layer utilities {
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--color-muted-foreground) 30%, transparent) transparent;
  }
}